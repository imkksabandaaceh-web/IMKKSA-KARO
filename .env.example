# ===========================================
# IMKKSA Banda Aceh — Environment Variables
# ===========================================
# Copy file ini ke .env dan isi dengan nilai yang sesuai:
#   cp .env.example .env
#
# PENTING: nilai asli HANYA diisi di file .env lokal dan di dashboard Vercel.
# File .env tidak pernah di-commit (lihat .gitignore).

# --- Supabase (dipakai browser, aman dipublikasikan) ---
# URL project Supabase (format: https://xxxxx.supabase.co)
VITE_SUPABASE_URL=

# Anon/public key dari Supabase Dashboard → Settings → API
VITE_SUPABASE_ANON_KEY=

# --- ImageKit (opsional) ---
# Endpoint ImageKit untuk proxy gambar Google Drive.
# Kosongkan untuk menggunakan default: https://ik.imagekit.io/imkksa
VITE_IMAGEKIT_ENDPOINT=

# ===========================================
# WhatsApp (fitur pendataan anggota) — KHUSUS SERVER
# ===========================================
# Nama variabel di bawah ini TIDAK diawali VITE_ supaya tidak ikut terkirim
# ke browser. Isi nilainya hanya di .env lokal dan di Vercel:
# Project → Settings → Environment Variables (centang Production & Preview).

# Token API Fonnte (Fonnte → device → token). Jangan dibagikan.
WA_GATEWAY_TOKEN=

# Kata sandi rahasia webhook. Bebas, panjang & acak (contoh: 32+ karakter).
# Nilai yang sama dipakai di URL webhook Fonnte: ?secret=...
WA_WEBHOOK_SECRET=

# URL project Supabase (sama dengan VITE_SUPABASE_URL di atas).
SUPABASE_URL=

# Kunci rahasia Supabase dari Dashboard → Settings → API Keys.
# Boleh kunci model baru (sb_secret_...) ATAU kunci lama service_role (JWT).
# BERSIFAT RAHASIA PENUH (melewati RLS). Hanya untuk server, jangan pernah
# dimasukkan ke variabel VITE_* dan jangan di-share.
SUPABASE_SERVICE_ROLE_KEY=
